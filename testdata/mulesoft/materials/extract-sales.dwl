%dw 2.0
output application/json
var data = vars.DATA
var sales = data.sales default []
---
sales map (item, index) -> {
	"materialCode": data.materialCode,
	"saleOrg": item.saleOrg,
	"distributionChannel": item.distributionChannel,
	"salesUnit": item.salesUnit,
	"taxClass1": item.taxClass1,
	"taxClass1Desc": item.taxClass1Desc,
	"materialGroup1": item.materialGroup1,
	"materialGroup2": item.materialGroup2,
	"materialGroup3": item.materialGroup3,
	"materialGroup4": item.materialGroup4,
	"materialGroup5": item.materialGroup5,
	"materialGroup1Desc": item.materialGroup1Desc,
	"materialGroup2Desc": item.materialGroup2Desc,
	"materialGroup3Desc": item.materialGroup3Desc,
	"materialGroup4Desc": item.materialGroup4Desc,
	"materialGroup5Desc": item.materialGroup5Desc,
	"deliveryPlant": item.deliveryPlant,
	"deliveryPlantDesc": item.deliveryPlantDesc,
	"productHierarchy": item.productHierarchy,
	"productHierarchyDesc": item.productHierarchyDesc,
	"productHierarchy1": item.productHierarchy1,
	"productHierarchy1Desc": item.productHierarchy1Desc,
	"productHierarchy2": item.productHierarchy2,
	"productHierarchy2Desc": item.productHierarchy2Desc,
	"productHierarchy3": item.productHierarchy3,
	"productHierarchy3Desc": item.productHierarchy3Desc,
	"productHierarchy4": item.productHierarchy4,
	"productHierarchy4Desc": item.productHierarchy4Desc,
	"productHierarchy5": item.productHierarchy5,
	"productHierarchy5Desc": item.productHierarchy5Desc,
	"productHierarchy6": item.productHierarchy6,
	"productHierarchy6Desc": item.productHierarchy6Desc,
	"materialPriceGroup": item.materialPriceGroup,
	"materialPriceGroupDesc": item.materialPriceGroupDesc,
	"itemCatGroup": item.itemCatGroup,
	"itemCatGroupDesc": item.itemCatGroupDesc,
	"status": item.status,
	"xchannelStatus": item.xchannelStatus,
	"xchannelStatusDesc": item.xchannelStatusDesc,
	"xchannelStatusValidFrom": item.xchannelStatusValidFrom,
	"distributionChannelStatus": item.distributionChannelStatus,
	"distributionChannelStatusDesc": item.distributionChannelStatusDesc,
	"distributionChannelStatusValidFrom": item.distributionChannelStatusValidFrom,
	"saleText1Th": item.saleText1Th,
	"saleText2Th": item.saleText2Th,
	"saleText3Th": item.saleText3Th,
	"saleText4Th": item.saleText4Th,
	"saleText1En": item.saleText1En,
	"saleText2En": item.saleText2En,
	"saleText3En": item.saleText3En,
	"saleText4En": item.saleText4En
}
